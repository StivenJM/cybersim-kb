filters:
  and:
    - file.inFolder("Papers")
    - note.type == "paper"
views:
  - type: table
    name: Corpus de investigación
    order:
      - file.name
      - year
      - lectura
      - preguntas
  - type: table
    name: Lecturas completas centrales
    filters:
      and:
        - note.lectura == "texto-completo"
    order:
      - file.name
      - year
      - preguntas
  - type: table
    name: Cribados y antecedentes
    filters:
      and:
        - note.lectura != "texto-completo"
    order:
      - file.name
      - lectura
      - preguntas
  - type: table
    name: Revisión de competencias de seguridad
    filters:
      and:
        - note.revision_competencias == "2026-11-16"
    order:
      - file.name
      - year
      - lectura
      - revision_competencias
